rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isValidUserData(data) {
      return data.keys().hasAll(['uid','email','displayName']) &&
             data.uid is string && data.email is string && data.displayName is string;
    }
    function isValidGoalData(data) {
      return data.keys().hasAll(['userId','title','category']) &&
             data.userId is string && data.title is string && data.category is string;
    }
    function isValidHabitData(data) {
      return data.keys().hasAll(['name','frequency','category']) &&
             data.name is string &&
             data.frequency in ['daily','weekly','monthly','custom'] &&
             data.category in ['health','productivity','learning','mindfulness','social','other'];
    }
    function isValidFocusSessionData(data) {
      return data.keys().hasAll(['duration','startTime']) &&
             data.duration is number && data.duration > 0 && data.duration <= 14400 &&
             data.startTime is timestamp;
    }
    function isValidAIInteractionData(data) {
      return data.keys().hasAll(['userId','timestamp','type']) &&
             data.userId is string && data.timestamp is timestamp &&
             data.type in ['motivation','advice','goal-breakdown','chat','analysis'];
    }

    // NESTED STRUCTURE: /users/{userId}/...
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /goals/{goalId} {
        allow read, update, delete: if isOwner(userId);
        // Nested goals do not require userId field; validate essential fields only
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['title','category']) &&
          (request.resource.data.title is string) &&
          (request.resource.data.category in ['health','productivity','learning','mindfulness','social','other','journey']);
      }
      match /habits/{habitId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHabitData(request.resource.data);
        allow update: if isOwner(userId);
      }
      match /focusSessions/{sessionId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFocusSessionData(request.resource.data);
      }
      match /transactions/{transactionId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && 
          request.resource.data.keys().hasAll(['type','category','amount','date']) &&
          request.resource.data.type in ['income','expense'] &&
          request.resource.data.amount is number && request.resource.data.amount > 0;
      }
      match /aiInteractions/{interactionId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAIInteractionData(request.resource.data);
      }
      match /achievements/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /analytics/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      // AI profile (nested)
      match /aiProfile/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /personalityProfiles/{docId} {
        allow read, write: if isOwner(userId);
      }
      // AI conversations (legacy and current)
      match /conversations/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /aiConversations/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /gamification/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community posts (global collection with user ownership)
    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['text','userId','createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if request.auth != null && 
        (resource.data.userId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.keys().hasAll(['text','userId','createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow update: if request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null &&
          (resource.data.userId == request.auth.uid ||
           get(/databases/$(database)/documents/communityPosts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // TOP-LEVEL (compat)
    match /goals/{goalId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && isValidGoalData(request.resource.data);
    }
    match /habits/{habitId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && isValidHabitData(request.resource.data);
    }
    match /focusSessions/{sessionId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && isValidFocusSessionData(request.resource.data);
    }
    match /aiInteractions/{interactionId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && isValidAIInteractionData(request.resource.data);
    }
    match /analytics/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /settings/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /personalityProfiles/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /conversations/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /gamification/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Catalogs / public data
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Shop catalog is public read-only, managed by admins out-of-band
    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /communityTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (resource == null || resource.data.createdBy == request.auth.uid)
                   && (request.resource == null || request.resource.data.createdBy == request.auth.uid);
    }
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (resource == null || resource.data.userId == request.auth.uid)
                   && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (resource == null || resource.data.createdBy == request.auth.uid)
                   && (request.resource == null || request.resource.data.createdBy == request.auth.uid);
    }

    // AI rate limits
    match /aiRateLimits/{userId} {
      allow read, write: if isOwner(userId);
    }
    // User purchases nested collection
    match /users/{userId}/purchases/{purchaseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['itemId','itemName','price','purchasedAt']) &&
        request.resource.data.price is number && request.resource.data.price >= 0 &&
        request.resource.data.purchasedAt is timestamp;
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


