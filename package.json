{
  "name": "operator-uplift",
  "version": "1.0.0",
  "description": "AI-integrated gamified self-progression app",
  "main": "app.html",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "dev": "python -m http.server 8080",
    "build": "echo 'Static build - no compilation needed'",
    "build:netlify": "echo 'Static build for Netlify'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "build:dev": "webpack --mode development",
    "type-check": "tsc --noEmit",
    "docs": "jsdoc js/**/*.js -d docs"
  },
  "keywords": [
    "ai",
    "gamification",
    "productivity",
    "self-improvement",
    "javascript",
    "html5",
    "firebase",
    "netlify"
  ],
  "author": "Operator Uplift Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.23.0",
    "@types/jest": "^29.5.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "jsdoc": "^4.0.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "firebase": "^10.7.0",
    "date-fns": "^2.30.0",
    "chart.js": "^4.4.0",
    "gsap": "^3.12.2",
    "tone": "^14.7.77",
    "tsparticles": "^2.12.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js",
      "!js/**/*.spec.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
