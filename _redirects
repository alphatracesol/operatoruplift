# SPA Routing - Handle all routes
# Allow direct access to specific pages
/MVP Launch Page.html    /MVP Launch Page.html   200
/mvp    /MVP Launch Page.html   200
/app    /app.html   200
/*    /app.html   200

# API Routes
/api/*    /.netlify/functions/:splat    200

# PWA Routes
/manifest.json    /manifest.json    200
/sw.js    /sw.js    200

# Fallback for 404
/*    /app.html    404
